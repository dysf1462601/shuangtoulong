# ==================== run_agent.py 配置文件 ====================

# Python 解释器路径（留空则使用当前运行的解释器）
PYTHON_EXEC=

# main.py 的启动参数
# autoglm 9b 的地址
BASE_URL=https://open.bigmodel.cn/api/paas/v4

#  DeepSeek LLM地址
BASE_URL2=

MAX_STEPS=20
MODEL_NAME=autoglm-phone

# ADB 无线设备ID（留空则自动检测）
DEVICE_ID=

# 智谱 API Key（免费）
API_KEY=

# DeepSeek API Key（用于生成评论，差不多免费）
#DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=

# 历史记录文件路径（留空则默认为脚本同目录下的 comment_history.txt）
HISTORY_FILE=

# 评论概率（0.0 ~ 1.0）
COMMENT_PROBABILITY=1

# 私信概率（0.0 ~ 1.0，剩余概率为随便刷刷）
PRIVATE_MSG_PROBABILITY=0

# 每轮任务结束后的随机等待范围（秒）
SLEEP_MIN=40
SLEEP_MAX=120



# 你的账号昵称（用于判定触底重置）
#ACCOUNT_NAME=你的真实抖音号昵称

# 想要搜索的视频关键词
SEARCH_KEYWORD=剧

# 生成评论时的博主人设设定
#FANS_PERSONA=你是一个热爱生活、关注各类美妆博主的女粉丝。

# 要传递的核心主题或广告软文方向
COMMENT_THEME=老师您很有创意，您现在用什么平台做AI视频呢，是不是很贵啊。现在AI发展真快，这边已经进入一分时代了，一秒4分钱跟白送一样，创作APP还免费用，躺在床上用手机就能做视频挣钱。有兴趣的话您点我头像，咱们交流交流呗。

# 大模型必须包含的关键词
COMMENT_KEYWORDS=老师、很贵、一分时代、APP、手机、点我头像

# 兜底默认评论（当大模型请求失败时发送的内容）
#DEFAULT_COMMENT=这个口红颜色真好看，适合日常上班涂。


# =============== 任务模式配置 ===============
# 可选值：
# INTERACT: 互动模式 (一直上下滑视频并自动发评论)
# COLLECT: 采集模式 (采集页面内的作者名并存入下方指定的文件里)
# PROCESS: 处理模式 (自动读取下方文件，循环搜索文件里的作者去互动，完事后删掉这一行)
# DRAMA_COMMENT 短剧APP 评论
RUN_MODE="INTERACT"

# 采集模式下，作者名称保存的文件路径（留空则默认保存在脚本同目录）
COLLECT_FILE=

# 要读取和处理的采集文件路径 (保持跟你采集时一样即可)
#COLLECT_FILE="collected_authors.csv"


# ==================== 采集模式专用高级配置（泛化支持） ====================

# 1. 目标APP名称（告诉大模型在哪个APP里操作，防止它乱点或退出）
# 默认值: 火龙漫剧
COLLECT_APP_NAME=火龙漫剧

# 2. 你要采集的“目标实体”叫什么（例如：作者名称、商品名称、店铺名字、视频点赞数等）
# 默认值: 作者名称
COLLECT_TARGET_ENTITY=作者名称

# 3. 目标输出时的前缀标识（最终大模型输出类似 COLLECT|作者:张三）
# 默认值: 作者
COLLECT_TARGET_PREFIX=作者

# 4. 找寻目标的视觉提示词（给大模型的指引，告诉它大概在屏幕哪个位置找）
# 默认值: 作者名通常在视频标题的上方或下方，或者在UP主头像旁边。
COLLECT_TARGET_HINT=作者名通常在视频标题的上方或下方，或者在UP主头像旁边。

# 5. 搜索时的筛选条件（针对首页/搜索页进入播放页时的操作提示）
# 默认值: 筛选"最新发布"和"未观看"
COLLECT_FILTER=筛选"最新发布"和"未观看"


# ==================== 终极自定义模板（可选，一般留空即可） ====================
# 如果上面的细颗粒度参数还不够，你想彻底重写整个 导航/采集 的 Prompt，可以直接在这里写长文本。
# 留空则自动使用 run_agent.py 代码中内置的强大模板。
# NAV_COLLECT_TEMPLATE=
# COLLECT_ACTION_TEMPLATE=






# ==================== 大脑配置 ====================
BRAIN_MODEL="GLM-5.3-flash"
#BRAIN_BASE_URL=BASE_URL2
#BRAIN_API_KEY=DEEPSEEK_API_KEY

# ==================== 循环 & 休眠（和 run_agent.py 对齐） ====================
LOOP=true
SLEEP_MIN=15
SLEEP_MAX=45
MAX_BRAIN_STEPS=200
TASK_TIMEOUT=300
SCREEN_STABLE_WAIT=2.5
HISTORY_KEEP_ROUNDS=15
MAX_STEPS_SUB=15

# ==================== 默认任务（可选） ====================
BRAIN_TASK=在BOSS直聘中，给推荐列表里的岗位逐个点击打招呼，点完一个返回继续下一个，变灰的跳过，当前页点完就往下滑












